{
  "name": "ai-watering-hole",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-watering-hole",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "ratelimits": [
    {
      "name": "POST_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "vars": {
    "WRITES_ENABLED": "true"
  }
}
